# --- Kopiér til .env (lokalt) eller saet som environment-variabler i Coolify ---

# Kodeord til /admin-siden. SKIFT DETTE!
ADMIN_PASSWORD=skift-mig-straks

# Hemmelig noegle til at signere admin-session-cookien. Generér fx med:
#   openssl rand -hex 32
SESSION_SECRET=skift-mig-til-en-lang-tilfaeldig-streng

# Hvor SQLite-filen ligger. I Coolify peger denne paa en persistent volume.
# Lokalt kan du lade den staa tom, saa bruges ./data/bygherrer.db
DATABASE_PATH=/app/data/bygherrer.db

# Vis-navn og disclaimer-variabler (saa du kan skifte domaene uden at roere koden)
SITE_DOMAIN=bugherrer.dk
SITE_NAME=Bugherrer

# --- Spam-værn: Cloudflare Turnstile (usynlig captcha) ---
# Hentes gratis i Cloudflare -> Turnstile -> Add widget. Du faar to nøgler.
# Begge er VALGFRIE: er de ikke sat, er captcha'en bare slukket, og alt virker som før.
#   Site Key   = offentlig, bruges i frontend (derfor NEXT_PUBLIC_-praefiks)
#   Secret Key = hemmelig, bruges i backend (del aldrig denne)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Oversættelse af rapporter (PDF/CSV) til engelsk/svensk via DeepL ---
# VALGFRI: er nøglen ikke sat, er rapportens ramme på det valgte sprog, men
# selve fejl-teksten forbliver dansk. Alt virker uanset.
# Hent en gratis nøgle på https://www.deepl.com/pro-api (DeepL API Free).
DEEPL_API_KEY=
# Kun hvis du bruger DeepL Pro i stedet for Free:
#   DEEPL_API_URL=https://api.deepl.com/v2/translate
DEEPL_API_URL=
